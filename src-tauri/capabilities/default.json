{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the Mio Jisho main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-message",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/Riko-Neko/mio-jisho/releases*"
        }
      ]
    }
  ]
}
